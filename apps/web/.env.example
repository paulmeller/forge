# Local dev defaults. Copy to .env.local and fill in.

DATABASE_URL=file:./local.db
# DATABASE_AUTH_TOKEN=  # required for remote Turso, omit for local libSQL

BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
# forge-web dev server runs on :3100 (see apps/web package.json)
BETTER_AUTH_URL=http://localhost:3100

# Execution backend: managed-agents (default) or gateway
FORGE_BACKEND=managed-agents

# Required for the chat console (always) and for FORGE_BACKEND=managed-agents
# ANTHROPIC_API_KEY=sk-ant-...

# Chat model, as provider:model-id. Defaults to anthropic:claude-sonnet-4-6.
# FORGE_CHAT_MODEL=anthropic:claude-sonnet-4-6

# Optional: route Anthropic calls through a proxy (e.g. AgentStep:
# https://www.agentstep.com/anthropic with your AgentStep key), or a local
# Anthropic-compatible server (e.g. Ollama: http://localhost:11434/v1 with
# FORGE_CHAT_MODEL=anthropic:<local-model-tag>).
# Note: the proxy sees your API key and all request/response traffic.
# ANTHROPIC_BASE_URL=

# Required if FORGE_BACKEND=gateway
# GATEWAY_URL=http://localhost:8787

# Git identity dispatched agents commit as. Defaults to "Forge Agent"
# <forge-agent@users.noreply.github.com> if unset.
# FORGE_GIT_AUTHOR_NAME=Forge Agent
# FORGE_GIT_AUTHOR_EMAIL=forge-agent@users.noreply.github.com

# Required for FORGE_BACKEND=gemini-managed-agents
# GEMINI_API_KEY=

# Gemini model alias to use. Defaults to gemini-pro-latest — do not pin a
# dated/versioned model string here (they get deprecated for new users).
# FORGE_GEMINI_MODEL=gemini-pro-latest

# Comma-separated allow-list of client_ids the device-authorization flow
# (/device) will accept. Unset means exactly "forge-cli", Forge's own CLI.
# An unknown client_id is rejected at /device/code before a row is created,
# so add an id here only for a client you actually trust with full account
# access — the flow issues an ordinary, unscoped session token.

# When a dispatched agent's own instructions violate the dispatch contract
# (server/tick/agent-contract.ts — e.g. it's told not to push, or to open the
# pull request itself), Forge always records a dispatch.contract_warning
# ledger event. Set to "true" to also refuse to dispatch the Task instead of
# only warning. Off by default: this is a denylist heuristic, not a proof, so
# a false positive would halt every Task on the affected agent.
# AGENT_CONTRACT_BLOCK=true
# FORGE_DEVICE_CLIENT_IDS=forge-cli
