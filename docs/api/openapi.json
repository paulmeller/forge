    "missions.create": {
      "operationId": "missions.create",
      "body": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "backend": {
            "type": "string",
            "enum": [
              "managed-agents",
              "gateway",
              "gemini-managed-agents"
            ]
          },
          "agentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "plannerStrategy": {
            "default": "rule-based",
            "type": "string",
            "enum": [
              "rule-based",
              "llm",
              "graph",
              "triage"
            ]
          },
          "targetRepos": {
            "default": [],
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9._-]+\\/[a-zA-Z0-9._-]+$"
            }
          },
          "issueQuery": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "concurrencyCap": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "budgetUsd": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "budgetTokens": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "budgetThresholdPct": {
            "default": 80,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "budgetHardStopPct": {
            "default": 100,
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "taskMaxTurns": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "taskMaxTokens": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "noProgressTokens": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "githubInstallationId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "githubVaultId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "skillId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "aiReviewEnabled": {
            "default": false,
            "type": "boolean"
          },
          "selfVerifyEnabled": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "goal",
          "backend",
          "agentId",
          "plannerStrategy",
          "targetRepos",
          "concurrencyCap",
          "budgetThresholdPct",
          "budgetHardStopPct",
          "aiReviewEnabled",
          "selfVerifyEnabled"
        ],
        "additionalProperties": false
      }
    },
